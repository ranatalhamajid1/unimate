# PostgreSQL connection string for Prisma ORM (Production database)
DATABASE_URL="postgresql://username:password@hostname:5432/unimate?schema=public"

# Session secret for JWT encryption (generate with: openssl rand -base64 32)
SESSION_SECRET="your-32-byte-base64-secret"

# AI Study Buddy (Google Gemini API)
AI_API_KEY="your-gemini-api-key"
AI_MODEL="gemini-3.6-flash"

# Application Base URL (Required for OAuth redirect resolution in production)
NEXT_PUBLIC_APP_URL="https://web-gamma-ten-40.vercel.app"

# Google Calendar Integration (Google Cloud Console OAuth 2.0 Web Application Client)
# Server-only. Do NOT expose to client/mobile bundles.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Object Storage: Cloudflare R2 (Required for production avatar storage)
# Server-only. Do NOT expose to client/mobile bundles.
STORAGE_DRIVER="r2"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="unimate-avatars"
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
R2_PUBLIC_URL="https://pub-<id>.r2.dev"

