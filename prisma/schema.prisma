// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User — authentication & profile
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  courses          Course[]
  timetableEntries TimetableEntry[]
  assignments      Assignment[]
  exams            Exam[]
  grades           CourseGrade[]
  attendance       Attendance[]
  expenses         Expense[]
  notifications    Notification[]
  studySessions    StudySession[]
  goals            StudentGoal[]
  studyPlans       StudyPlan[]
  subscription     Subscription?
  aiUsages         AIUsage[]

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Course — university courses enrolled by the user
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String
  instructor  String   @default("")
  creditHours Int      @default(3)
  semester    String   @default("")
  color       String   @default("#2563eb")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  assignments      Assignment[]
  exams            Exam[]
  grades           CourseGrade[]
  attendance       Attendance[]
  studySessions    StudySession[]
  studyPlanItems   StudyPlanItem[]

  @@index([userId])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// TimetableEntry — weekly university class schedule
// ---------------------------------------------------------------------------

model TimetableEntry {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  dayOfWeek Int // 1 = Monday, 2 = Tuesday, ..., 7 = Sunday
  startTime String // "09:00", "10:30"
  endTime   String // "10:00", "12:00"
  room      String   @default("")
  type      String   @default("Lecture") // Lecture, Lab, Tutorial, Other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([userId, dayOfWeek])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Assignment — course assignments, homework, and tasks
// ---------------------------------------------------------------------------

model Assignment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  title       String
  description String   @default("")
  dueDate     DateTime
  priority    String // LOW, MEDIUM, HIGH
  status      String // NOT_STARTED, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([dueDate])
  @@index([userId, dueDate])
  @@map("assignments")
}

// ---------------------------------------------------------------------------
// Exam — university exams, midterms, quizzes
// ---------------------------------------------------------------------------

model Exam {
  id                  String   @id @default(cuid())
  userId              String
  courseId            String
  title               String
  examDate            DateTime
  room                String   @default("")
  type                String // MIDTERM, FINAL, QUIZ, OTHER
  status              String // UPCOMING, COMPLETED
  preparationProgress Int      @default(0) // 0-100%
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([examDate])
  @@index([userId, examDate])
  @@map("exams")
}

// ---------------------------------------------------------------------------
// CourseGrade — academic grade for a course
// ---------------------------------------------------------------------------

model CourseGrade {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  grade       String
  gradePoints Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_grades")
}

// ---------------------------------------------------------------------------
// Attendance — class attendance record for a course
// ---------------------------------------------------------------------------

model Attendance {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  totalClasses    Int      @default(0)
  attendedClasses Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Expense — university and personal expense tracking
// ---------------------------------------------------------------------------

model Expense {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  description String   @default("")
  expenseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expenseDate])
  @@index([userId, expenseDate])
  @@index([userId, category])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notification — database-backed academic reminders and alerts
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  type    String
  title   String
  message String

  relatedId String?
  read      Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// StudySession — actual study session tracking (minutes)
// ---------------------------------------------------------------------------

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  duration    Int // duration in minutes
  sessionDate DateTime
  source      String   @default("MANUAL") // MANUAL, STUDY_PLAN, AI_PLAN
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([userId, sessionDate])
  @@map("study_sessions")
}

// ---------------------------------------------------------------------------
// StudentGoal — persistent academic and productivity goals
// ---------------------------------------------------------------------------

model StudentGoal {
  id          String   @id @default(cuid())
  userId      String
  type        String // TARGET_GPA, ATTENDANCE, WEEKLY_STUDY_HOURS, ASSIGNMENT_COMPLETION
  targetValue Float
  period      String // CURRENT, WEEKLY, MONTHLY, SEMESTER
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
  @@map("student_goals")
}

// ---------------------------------------------------------------------------
// StudyPlan — daily/weekly structured study plans
// ---------------------------------------------------------------------------

model StudyPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StudyPlanItem[]

  @@index([userId])
  @@index([userId, startDate])
  @@map("study_plans")
}

// ---------------------------------------------------------------------------
// StudyPlanItem — individual scheduled task within a study plan
// ---------------------------------------------------------------------------

model StudyPlanItem {
  id          String   @id @default(cuid())
  studyPlanId String
  courseId    String?
  title       String
  description String   @default("")
  scheduledAt DateTime
  duration    Int // duration in minutes
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([studyPlanId])
  @@index([courseId])
  @@index([scheduledAt])
  @@map("study_plan_items")
}

// ---------------------------------------------------------------------------
// Subscription — provider-agnostic SaaS subscription state
// ---------------------------------------------------------------------------

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  plan                   String    @default("FREE") // FREE, PRO
  status                 String    @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE, PAUSED, TRIALING
  provider               String    @default("NONE") // PADDLE, LEMONSQUEEZY, MOCK, MANUAL
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerCustomerId])
  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// AIUsage — durable daily AI request quota tracking
// ---------------------------------------------------------------------------

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  date         String   // "YYYY-MM-DD" in Asia/Karachi (PKT) for deterministic daily resets
  requestCount Int      @default(0)
  tokenCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("ai_usages")
}

